<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;net7.0</TargetFrameworks>
    <OutputType>library</OutputType>
    <RootNamespace>Renouveau.Caffeine</RootNamespace>
    <!-- project friendly name = file description (properties) -->
    <AssemblyTitle>Renouveau.Caffeine</AssemblyTitle>
    <!-- file name = original file name (properties) -->
    <AssemblyName>Renouveau.Caffeine</AssemblyName>
    <Copyright>Copyright © 2026 Ji Luo, all rights reserved.</Copyright>
    <Description>For requesting the system not go idle so that long-running tasks continue uninterrupted.</Description>
    <!-- Write-AssemblyMetadata.ps1 -->
    <Version>0.1.1</Version>
    <ps1_IsStable>false</ps1_IsStable>
    <ps1_AssemblyMetadata>true</ps1_AssemblyMetadata>
    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Renouveau.Caffeine</PackageId>
    <Authors>Ji Luo</Authors>
    <PackageTags>awake sleep idle display screen power-management windows</PackageTags>
    <PackageReleaseNotes>Improved thread-safety during shutdown/unload in .NET Framework. Currently only supporting Windows.</PackageReleaseNotes>
  </PropertyGroup>

  <Import Project="./../sln.csproj.xml" />

  <PropertyGroup Condition="'$(TargetFramework)' == 'net461'">
    <DefineConstants>$(DefineConstants);IS_Windows_only</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'net461'">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

</Project>
